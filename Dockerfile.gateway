# Pinned to the newest release inside Scarf's documented compatibility window.
# Scarf v3.8.0 (2026-11-02) states "Compatible with Hermes v0.6.0 through v0.22.5";
# its /undo + /retry support needs Hermes v0.22.3+. v0.22.7 is the newest patch of
# that same 0.22 line. Bump this pin when Scarf announces support for a newer line
# (Hermes v0.23.0 shipped 2026-11-05, after Scarf v3.8.0).
FROM nousresearch/hermes-agent:v0.22.7

# v0.22.7's venv is uv-managed and ships neither uv nor pip on PATH, so the old
# `. /opt/hermes/.venv/bin/activate && uv pip install ...` line failed the build
# with "uv: not found". Install uv, then target the venv interpreter directly —
# activating it under /bin/sh (dash) also emitted "realpath: '': No such file".
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh \
 && uv pip install --python /opt/hermes/.venv/bin/python "hindsight-client>=0.4.22"

# Fix v0.22.7's Groq reasoning wire. Its custom provider profile hardcoded
# reasoning_effort="default" for api.groq.com (or "none" for a disabled config);
# Groq accepts only "low" / "medium" / "high" and 400s on both, so every turn on a
# Groq custom endpoint failed with "Your request was not processed". The patch file
# carries the full rationale and the removal trigger (#75089).
COPY patches/model-provider-custom-patched.py /opt/hermes/plugins/model-providers/custom/__init__.py

# No ENTRYPOINT override — let /init (s6-overlay) handle UID/GID remap,
# volume chown, config seeding, and skills sync via cont-init scripts.
# The compose CMD (config set + gateway run) is executed by
# main-wrapper.sh as the hermes user via s6-setuidgid.
#
# See: https://hermes-agent.nousresearch.com/docs/user-guide/docker
